# ContactHub Environment Configuration Template
# Copy this file to .env and customize for your environment:
#   Copy-Item .env.example .env (Windows PowerShell)
#   cp .env.example .env (Linux/macOS)

# Flask Secret Key for session security (generate a random 32-character hex key)
SECRET_KEY=replace-with-a-very-long-random-secret-key-32-chars

# Database Location (defaults to database/contacthub.db inside the project folder)
DATABASE_PATH=database/contacthub.db

# Flask Server Port (default: 5000)
PORT=5000

# Debug Mode (set to False in production and Docker)
FLASK_DEBUG=False
