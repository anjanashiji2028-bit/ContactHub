apiVersion: v1
kind: Secret
metadata:
  name: contacthub-secret
  namespace: contacthub
  labels:
    app: contacthub
type: Opaque
stringData:
  # Sensitive application secrets
  # In production, replace with a securely generated random key
  SECRET_KEY: "k8s-prod-super-secret-key-contacthub-session-2026"
